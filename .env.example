# DIANA · demo — todas as variáveis têm default que roda SEM credencial nenhuma.
# Copie para `.env` só se quiser mudar algo. Nada aqui é obrigatório para a demo.

# ---------------------------------------------------------------------------
# Motor de análise
# ---------------------------------------------------------------------------
# mock = heurística local determinística (padrão, sem custo, sem credencial)
# oci  = OCI Generative AI (exige as variáveis abaixo; ver packages/analyzer)
ANALYZER=mock

# Só para ANALYZER=oci
OCI_COMPARTMENT_ID=
OCI_MODEL_ID=
OCI_REGION=

# ---------------------------------------------------------------------------
# Fonte de alertas lida pela guardian-api
# ---------------------------------------------------------------------------
# file     = lê o que o núcleo gravou em STATE_DIR (usado por `npm run demo`)
# fixtures = alertas embutidos na própria API (não precisa rodar o núcleo)
# oci      = OCI Object Storage (ainda não implementado nesta demo)
ALERTS_SOURCE=file
STATE_DIR=./demo-state

# Só para ALERTS_SOURCE=oci
OCI_OS_BUCKET=diana-monitoring
OCI_OS_NAMESPACE=
OCI_OS_REGION=

# ---------------------------------------------------------------------------
# API HTTP
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=*

# Vazio = API aberta (apropriado só para demo local).
# Definido = exige o header `x-api-key` em todas as rotas, exceto /health.
# NÃO é controle de acesso de verdade: não há identidade nem autorização por
# responsável. Autenticação real (OIDC) é assunto da Fase 2.
GUARDIAN_API_KEY=

# ---------------------------------------------------------------------------
# Front-end
# ---------------------------------------------------------------------------
# Para onde o Vite encaminha as chamadas /api durante o desenvolvimento.
GUARDIAN_API_URL=http://localhost:8080
