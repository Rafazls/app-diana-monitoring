# DIANA · backend — todos os defaults rodam SEM credencial nenhuma.
# Copie para `.env` apenas se quiser mudar algo.

# ---------------------------------------------------------------------------
# Ingestão — de onde vêm as conversas
# ---------------------------------------------------------------------------
# fixtures = conversas de exemplo (padrão; sobe sem bot e sem token)
# telegram = bot real via long polling
INGESTION=fixtures

# Só para INGESTION=telegram — token do @BotFather.
TELEGRAM_BOT_TOKEN=
# Id numérico do Telegram da criança monitorada. Sem ele não há como saber
# quem falou o quê, e vários padrões (que só contam vindos do interlocutor)
# deixam de ser detectados.
TELEGRAM_CHILD_ID=
CHILD_NAME=Criança

# Base da Bot API. Vazio = Telegram real. Aponte para o simulador local
# (tools/telegram-sim.mjs) para testar a ingestão sem bot nem conta.
TELEGRAM_API_BASE=

# ---------------------------------------------------------------------------
# Batches — a cadência do monitoramento
# ---------------------------------------------------------------------------
# A cada BATCH_INTERVAL_MS a aplicação verifica se chegou mensagem nova. Se
# chegou, fecha um batch, persiste, e analisa os últimos CONTEXT_BATCHES
# batches juntos — o padrão de risco só aparece no contexto, raramente numa
# mensagem isolada.
#
# Regule pela velocidade do seu analisador: se uma análise demora mais que o
# intervalo, a fila cresce mais rápido do que esvazia e o alerta atrasa. Com
# modelo em CPU x86 rápida, 10s serve; em ARM sem AVX512, use 60000.
BATCH_INTERVAL_MS=10000
CONTEXT_BATCHES=3

# ---------------------------------------------------------------------------
# Análise de risco
# ---------------------------------------------------------------------------
# mock   = heurística local determinística (padrão, sem custo, sem credencial)
# server = modelo próprio (VM, servidor local, qualquer API compatível)
# oci    = OCI Generative AI (exige conta paga — não está no Always Free)
#
# Em qualquer opção, quem PONTUA é o Risk Engine — o modelo apenas aponta os
# sinais. Assim a nota não muda quando o motor muda.
ANALYZER=mock

# ---------------------------------------------------------------------------
# Modelo próprio — obrigatórios quando ANALYZER=server
# ---------------------------------------------------------------------------
# Funciona com llama.cpp server, Ollama, vLLM, LM Studio e TGI: todos falam o
# mesmo dialeto de API. Ver docs/modelo-proprio.md.
#
# ⚠️ Este arquivo NÃO expande variável de shell. Quem lê é o Node, não o bash:
#    `http://$VM_IP:8000/v1` fica literalmente com o cifrão, e a aplicação cai
#    calada no fallback heurístico — você vê alertas sem o modelo ter sido
#    consultado. Escreva o IP por extenso. Vale para $HOME também.
#
# Exemplos reais:
#   modelo na própria máquina .. http://127.0.0.1:8000/v1
#   modelo numa VM ............. http://192.0.2.10:8000/v1
#   Ollama ..................... http://127.0.0.1:11434/v1
#
# MODEL_SERVER_MODEL tem que ser exatamente o `id` que o servidor publica.
# Confira com: curl -s http://SEU_SERVIDOR:8000/v1/models
MODEL_SERVER_URL=
MODEL_SERVER_MODEL=
# Servidores locais normalmente não exigem chave.
MODEL_SERVER_API_KEY=
# Sem GPU a inferência é lenta. Em ARM sem AVX512 uma análise passa de 1 min,
# então o teto precisa de folga: cortar no meio vira conversa não analisada.
MODEL_SERVER_TIMEOUT_MS=120000
MODEL_SERVER_MAX_RETRIES=3
# Alguns servidores não aceitam response_format: use false se der erro.
MODEL_SERVER_JSON_MODE=true

# --- obrigatórios quando ANALYZER=oci ---
OCI_COMPARTMENT_ID=
OCI_MODEL_ID=
OCI_REGION=
# cohere  = família Cohere Command (padrão)
# generic = família Meta Llama e compatíveis
OCI_MODEL_FAMILY=cohere
OCI_TIMEOUT_MS=30000
# Repetições quando a OCI responde 429 (limite de taxa da tenancy).
# O espaçamento cresce a cada tentativa: 1s, 2s, 4s.
OCI_MAX_RETRIES=3

# --- credenciais de API: SÓ para rodar LOCALMENTE ---
# Em Container Instance, deixe tudo isto VAZIO: a aplicação usa instance
# principal e não precisa de credencial nenhuma.
OCI_TENANCY_ID=
OCI_USER_ID=
OCI_FINGERPRINT=
# A chave privada em uma linha só, com \n no lugar das quebras.
OCI_PRIVATE_KEY=
OCI_PASSPHRASE=

# ---------------------------------------------------------------------------
# Persistência dos alertas
# ---------------------------------------------------------------------------
# memory = some no reinício (padrão, ótimo para demo)
# file   = grava em STATE_DIR/alerts/<conversa>/<data>.json
# oracle = Oracle Database (batches + alertas). Tabelas criadas na 1ª execução.
#          A marcação de lido continua em memória e se perde no reinício,
#          igual nas outras opções — o alerta persiste, o "já vi" não.
STORE=memory
STATE_DIR=./.state

# --- obrigatórios quando STORE=oracle ---
ORACLE_USER=
ORACLE_PASSWORD=
# Autonomous Database: o alias do tnsnames (ex.: dianadb_high)
# Base Database:       host:porta/serviço
ORACLE_CONNECT_STRING=
# Só para ADB com mTLS: pasta onde o wallet foi extraído.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# ---------------------------------------------------------------------------
# API HTTP
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Origens do front. Em produção, restrinja.
CORS_ORIGINS=*

# Vazio = API aberta (apropriado só para demo local).
# Definido = exige header `x-api-key` em todas as rotas, exceto /health.
# NÃO é controle de acesso real: não há identidade nem autorização por
# responsável. Autenticação de verdade (OIDC) é assunto da Fase 2.
GUARDIAN_API_KEY=
