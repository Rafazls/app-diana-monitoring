# fixtures = conversas de exemplo (padrão; sobe sem bot e sem token)
# telegram = bot real via long polling
INGESTION=telegram

TELEGRAM_BOT_TOKEN= # Id do bot do Telegram (ex.: 8613512700:AAG30Sbra-0xpXi0gl_1GqfnOAF423fasd)
TELEGRAM_CHILD_ID= # Id do usuário (Crinça) do Telegram (ex.: 8401285341)
CHILD_NAME=Pedro

# baixe para uns 5000 ao testar, para não esperar a cada mensagem.
TELEGRAM_IDLE_MS=10000
                    
# file   = grava em STATE_DIR/alerts/<conversa>/<data>.json
STORE=memory
STATE_DIR=./.state

PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=*

# Vazio = API aberta.
# Definido = exige header `x-api-key` em todas as rotas, exceto /health.
GUARDIAN_API_KEY=

# Para usar o modelo local (mock) ou o OCI, descomente e configure as variáveis abaixo.
#ANALYZER=mock
ANALYZER=server
MODEL_SERVER_URL=http://127.0.0.1:8000/v1 #Docker local
MODEL_SERVER_MODEL=qwen2.5-3b
MODEL_SERVER_JSON_MODE=true

# ============================================================================================

#ANALYZER=server
#MODEL_SERVER_URL=http://255.255.1.1:8000/v1 # Substitua pelo IP do servidor de modelo (ex.: OCI, VM, etc.)
#MODEL_SERVER_MODEL=qwen2.5-3b

#ORACLE_USER=ADMIN
#ORACLE_PASSWORD=<senha-do-admin-do-adb>
#ORACLE_CONNECT_STRING=dianadb_tp
#ORACLE_WALLET_DIR=/home/SEU_USUARIO/.oci/diana-wallet
#ORACLE_WALLET_PASSWORD=<senha-da-wallet>

# Modelo em ARM (VM A2) leva ~35-60s por análise; 10s empilharia fila.
#BATCH_INTERVAL_MS=60000

# Intervalo mínimo entre dois alertas da MESMA conversa (não é o intervalo
# global de varredura — isso é BATCH_INTERVAL_MS, acima). Padrão: 2h.
ALERT_COOLDOWN_MS=7200000
