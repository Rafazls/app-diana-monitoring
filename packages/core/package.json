{
  "name": "@diana/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Núcleo da DIANA na demo: conversas de exemplo -> análise de risco -> alertas persistidos.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node dist/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@diana/analyzer": "*",
    "@diana/contracts": "*"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
