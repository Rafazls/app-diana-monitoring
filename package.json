{
  "name": "app-diana-monitoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DIANA — backend: conecta ao Telegram, analisa as conversas e serve os alertas ao app do responsável.",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -w -p tsconfig.json & sleep 3 && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
